# IA (console.anthropic.com > API Keys). Defina um limite de gasto mensal baixo no console.
ANTHROPIC_API_KEY=
# SELLPY_MODEL=claude-haiku-5-5

# Banco: sem isso usa SQLite local (sellpy.db). No Render, use o Postgres gratuito do Neon.
# DATABASE_URL=postgresql://usuario:senha@host/banco

# WhatsApp Cloud API (developers.facebook.com > seu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=invente-um-texto-qualquer
WHATSAPP_APP_SECRET=

# "dev" aceita webhook sem assinatura quando WHATSAPP_APP_SECRET está vazio. Em produção use "production".
SELLPY_ENV=dev

# Limites para controlar o custo da IA
SELLPY_DAILY_LIMIT=40
SELLPY_DEMO_DAILY_LIMIT=20
SELLPY_DEMO_GLOBAL_LIMIT=300
SELLPY_DEMO_ENABLED=true
